{
	"name": "@elyspio/vite-eslint-config",
	"version": "8.0.0-rc.0",
	"description": "Shared Vite+ defaults for React, TypeScript, Oxlint and Oxfmt projects.",
	"license": "MIT",
	"files": [
		"lib",
		"tsconfig.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./lib/index.d.mts",
	"exports": {
		".": {
			"types": "./lib/index.d.mts",
			"import": "./lib/index.mjs",
			"default": "./lib/index.mjs"
		},
		"./vite/vite.config": {
			"types": "./lib/vite/vite.config.d.mts",
			"import": "./lib/vite/vite.config.mjs",
			"default": "./lib/vite/vite.config.mjs"
		},
		"./api/generate": {
			"types": "./lib/api/generate.d.mts",
			"import": "./lib/api/generate.mjs",
			"default": "./lib/api/generate.mjs"
		},
		"./tsconfig.json": {
			"import": "./tsconfig.json",
			"require": "./tsconfig.json",
			"default": "./tsconfig.json"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"check": "vp check",
		"pack": "pnpm run clean && vp pack && node scripts/prepare-dist.ts",
		"build": "pnpm run pack",
		"version:sync": "node scripts/version.ts",
		"publish": "pnpm run version:sync && pnpm run pack && cd dist && npm publish"
	},
	"dependencies": {
		"@babel/core": "^8.0.6",
		"@rolldown/plugin-babel": "^0.2.4",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"vite-plugin-mkcert": "^2.1.0",
		"vite-plugin-svgr": "^5.2.0"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"@types/node": "^26.6.2",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@hey-api/openapi-ts": ">=0.99.0",
		"vite-plus": "^1.0.0-rc.0"
	},
	"peerDependenciesMeta": {
		"@hey-api/openapi-ts": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "pnpm@12.5.1"
}
