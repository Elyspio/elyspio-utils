{
	"name": "@elyspio/vite-eslint-config",
	"version": "5.0.3",
	"description": "Shared Vite+ defaults for React, TypeScript, Oxlint and Oxfmt projects.",
	"license": "MIT",
	"files": [
		"lib",
		"eslint.config.mjs",
		"prettier.config.js",
		"tsconfig.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./lib/index.d.mts",
	"exports": {
		".": {
			"types": "./lib/index.d.mts",
			"import": "./lib/index.mjs",
			"default": "./lib/index.mjs"
		},
		"./vite/vite.config": {
			"types": "./lib/vite/vite.config.d.mts",
			"import": "./lib/vite/vite.config.mjs",
			"default": "./lib/vite/vite.config.mjs"
		},
		"./api/generate": {
			"types": "./lib/api/generate.d.mts",
			"import": "./lib/api/generate.mjs",
			"default": "./lib/api/generate.mjs"
		},
		"./eslint.config.mjs": {
			"import": "./eslint.config.mjs",
			"default": "./eslint.config.mjs"
		},
		"./prettier.config.js": {
			"import": "./prettier.config.js",
			"default": "./prettier.config.js"
		},
		"./tsconfig.json": {
			"import": "./tsconfig.json",
			"require": "./tsconfig.json",
			"default": "./tsconfig.json"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "rimraf dist",
		"check": "vp check",
		"pack": "pnpm run clean && vp pack && tsx scripts/prepare-dist.ts",
		"build": "pnpm run pack",
		"version:sync": "tsx scripts/version.ts",
		"publish": "pnpm run version:sync && pnpm run pack && cd dist && npm publish"
	},
	"dependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@eslint/js": "^9.39.4",
		"@rolldown/plugin-babel": "^0.2.1",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"babel-plugin-transform-typescript-metadata": "^0.4.0",
		"eslint": "9.39.4",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.57.1",
		"vite": "8.0.0",
		"vite-plugin-mkcert": "^1.17.10",
		"vite-plugin-svgr": "^4.5.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@types/semver": "^7.7.1",
		"rimraf": "^6.1.3",
		"semver": "^7.7.4",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite-plus": "^0.1.15"
	},
	"peerDependencies": {
		"vite-plus": "^0.1.15"
	},
	"packageManager": "pnpm@10.32.1"
}