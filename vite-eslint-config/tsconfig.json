{
	"compilerOptions": {
		"lib": [
			"ES2022",
			"esNext"
		],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"outDir": "out-js",
		"declaration": true
	},
	"include": [
		"./src",
		"./scripts"
	]
}
