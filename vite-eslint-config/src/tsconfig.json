{
	"compilerOptions": {
		"allowJs": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"paths": {
			"@/*": ["${configDir}/src/*"],
			"@apis/*": ["${configDir}/src/core/apis/*"],
			"@components/*": ["${configDir}/src/view/components/*"],
			"@hooks/*": ["${configDir}/src/view/hooks/*"],
			"@pages/*": ["${configDir}/src/view/pages/*"],
			"@modules/*": ["${configDir}/src/store/modules/*"],
			"@services/*": ["${configDir}/src/core/services/*"],
			"@validators/*": ["${configDir}/src/core/validators/*"],
			"@store": ["${configDir}/src/store/index.ts"],
			"@store/*": ["${configDir}/src/store/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2024"
	},
	"include": ["${configDir}/src"]
}
