<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Elyspio.Utils.Telemetry.MongoDB</PackageId>
		<Version>2.0.0</Version>
		<PackageDescription>Bootstrap OpenTelemetry instrumentation/exporter</PackageDescription>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MongoDB.Driver" Version="3.10.0" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\readme.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Elyspio.Utils.Telemetry.csproj"/>
	</ItemGroup>

</Project>
