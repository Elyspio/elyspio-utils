<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Analyzers load in the compiler: netstandard2.0, Roslyn no newer than the oldest supported SDK. -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<!-- RS1038: the code fix lives beside the analyzer, which never touches Workspaces types. RS2008: no release tracking for one rule. -->
		<NoWarn>$(NoWarn);RS1038;RS2008</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Elyspio.Utils.Telemetry.Tests" />
	</ItemGroup>

</Project>
