<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Elyspio.Utils.Telemetry.Sql</PackageId>
		<Version>3.0.0-preview.3</Version>
		<PackageDescription>Bootstrap OpenTelemetry instrumentation/exporter</PackageDescription>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RootNamespace>Elyspio.Utils.Telemetry.Sql</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<!-- Transitive 9.0.x of SqlClient has known vulnerabilities (GHSA-846f-f764-76mx). -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Elyspio.Utils.Telemetry.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Elyspio.Utils.Telemetry.Sql.Tests" />
	</ItemGroup>

</Project>
