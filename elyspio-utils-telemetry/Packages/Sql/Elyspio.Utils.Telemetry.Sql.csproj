<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>Elyspio.Utils.Telemetry.Sql</PackageId>
		<Version>2.0.0</Version>
		<PackageDescription>Bootstrap OpenTelemetry instrumentation/exporter</PackageDescription>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RootNamespace>Elyspio.Utils.Telemetry.Sql</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.17.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\readme.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Elyspio.Utils.Telemetry.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Elyspio.Utils.Telemetry.Sql.Tests" />
	</ItemGroup>

</Project>
