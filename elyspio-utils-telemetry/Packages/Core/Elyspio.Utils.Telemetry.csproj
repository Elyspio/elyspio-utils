<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<PackageId>Elyspio.Utils.Telemetry</PackageId>
		<Version>3.0.0</Version>
		<PackageDescription>OpenTelemetry bootstrap configured by the standard OTEL_* settings, Serilog logs and composition-based trace scopes</PackageDescription>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\elyspio-utils-results\Packages\Core\Elyspio.Utils.Results.csproj" />
		<ProjectReference Include="..\Analyzers\Elyspio.Utils.Telemetry.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!-- ELY0001 ships in the package: every consumer gets the analyzer and its code fix. -->
	<ItemGroup>
		<None Include="..\Analyzers\bin\$(Configuration)\netstandard2.0\Elyspio.Utils.Telemetry.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Elyspio.Utils.Telemetry.Tests" />
	</ItemGroup>

</Project>
